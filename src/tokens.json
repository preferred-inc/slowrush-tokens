{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Slow Rush Coffee のデザイントークン。色の根拠はロゴSVGの実カラー。",
  "color": {
    "teal": {
      "$type": "color",
      "$value": "#00666B",
      "$description": "Primary。見出し・罫線・帯・シンボル。1枚の中で使う色はこれだけ"
    },
    "tealDark": {
      "$type": "color",
      "$value": "#004A4E",
      "$description": "背景ベタ用の濃度違い"
    },
    "espresso": {
      "$type": "color",
      "$value": "#48322A",
      "$description": "ロゴの茶。ロゴとキッカーのみ。面で塗らない"
    },
    "cream": {
      "$type": "color",
      "$value": "#F4F1EA",
      "$description": "基本背景。白は使わない"
    },
    "sand": {
      "$type": "color",
      "$value": "#E9E4D9",
      "$description": "カード・帯・罫線"
    },
    "material": {
      "$type": "color",
      "$value": "#D9CFC0",
      "$description": "グッズの生地・クラフト紙"
    },
    "charcoal": {
      "$type": "color",
      "$value": "#26241F",
      "$description": "本文。cream 上 13.74:1"
    },
    "subtle": {
      "$type": "color",
      "$value": "#6B6558",
      "$description": "注釈。cream 上 5.13:1 / sand 上 4.57:1。これより薄くしない"
    },
    "danger": {
      "$type": "color",
      "$value": "#A94438",
      "$description": "エラー・必須。多用しない"
    }
  },
  "fontFamily": {
    "display": {
      "$type": "fontFamily",
      "$value": ["EB Garamond", "Zen Old Mincho", "serif"],
      "$description": "見出し。大きく組んだときに効く"
    },
    "ui": {
      "$type": "fontFamily",
      "$value": ["Source Sans 3", "sans-serif"],
      "$description": "UIのラベル・価格・数字。ロゴのワードマークと同系"
    },
    "jp": {
      "$type": "fontFamily",
      "$value": ["Zen Kaku Gothic New", "sans-serif"],
      "$description": "日本語本文"
    },
    "tagline": {
      "$type": "fontFamily",
      "$value": ["Zen Old Mincho", "serif"],
      "$description": "「ゆっくり、急げ。」専用。他に広げない"
    }
  },
  "spacing": {
    "s1": { "$type": "dimension", "$value": "8px" },
    "s2": { "$type": "dimension", "$value": "16px" },
    "s3": { "$type": "dimension", "$value": "24px" },
    "s4": { "$type": "dimension", "$value": "32px" },
    "s5": { "$type": "dimension", "$value": "40px" },
    "s6": { "$type": "dimension", "$value": "48px" },
    "s8": { "$type": "dimension", "$value": "64px" },
    "s10": { "$type": "dimension", "$value": "80px" },
    "s14": { "$type": "dimension", "$value": "112px" },
    "s20": {
      "$type": "dimension",
      "$value": "160px",
      "$description": "セクションの上下。広く取るのがブランド"
    }
  },
  "radius": {
    "none": { "$type": "dimension", "$value": "0" },
    "sm": { "$type": "dimension", "$value": "2px" },
    "pill": {
      "$type": "dimension",
      "$value": "9999px",
      "$description": "角丸は 0 か pill の二択"
    }
  }
}
